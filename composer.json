{
    "name": "riari/laravel-forum-frontend",
    "description": "A frontend for riari/laravel-forum providing views written with Bootstrap 3",
    "keywords": ["laravel", "forum", "discuss", "frontend"],
    "license": "MIT",
    "authors": [
        {
            "name": "Riari",
            "email": "riari@teamteatime.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "riari/laravel-forum": "dev-naesa-upgrade-laravel-13"
    },
    "autoload": {
        "psr-4": {
            "Riari\\Forum\\Frontend\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riari\\Forum\\Frontend\\ForumFrontendServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/syal-tech/laravel-forum"
        }
    ]
}
